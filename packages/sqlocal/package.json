{
  "name": "@hozon/sqlocal",
  "version": "0.0.0",
  "description": "Browser OPFS SQLite adapter (SQLocal) for Hozon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TairuFramework/hozon.git",
    "directory": "packages/sqlocal"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib/*"
  ],
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "build:clean": "del-cli lib",
    "build:js": "del-cli \"lib/**/*.js\" && swc src -d ./lib --config-file ../../node_modules/@kigu/dev/swc.json --strip-leading-paths",
    "build:types": "del-cli \"lib/**/*.d.ts\" \"lib/**/*.d.ts.map\" && tsc --emitDeclarationOnly --skipLibCheck",
    "build:types:ci": "tsc --emitDeclarationOnly --skipLibCheck --declarationMap false",
    "prepack": "pnpm run build:clean && pnpm run build:js && pnpm run build:types:ci",
    "test": "pnpm run test:types",
    "test:types": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@hozon/adapter": "workspace:^",
    "kysely": "catalog:"
  },
  "devDependencies": {
    "del-cli": "catalog:",
    "sqlocal": "catalog:"
  },
  "peerDependencies": {
    "sqlocal": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
